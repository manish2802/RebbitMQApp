mkdir fluent-bit
cd fluent-bit

vi fluent-bit.conf
[SERVICE]
    Flush        1
    Log_Level    info

[INPUT]
    Name         tail
    Path         /var/lib/docker/containers/*/*.log
    Parser       docker
    Tag          docker.*

[OUTPUT]
    Name         es
    Match        *
    Host         elasticsearch
    Port         9200
    Index        docker-logs
    Logstash_Format On
    Replace_Dots On
    Suppress_Type_Name On
    
docker run -d \
  --name fluent-bit \
  --network redis-network \
  -v "$(pwd)/fluent-bit.conf:/fluent-bit/etc/fluent-bit.conf:ro" \
  -v /var/lib/docker/containers:/var/lib/docker/containers:ro \
  fluent/fluent-bit:3.1    